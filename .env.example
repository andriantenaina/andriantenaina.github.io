# Copy to pro/.env AND creative/.env (same values: both versions live on the same domain).

# Final public URL of the site (used for canonical, hreflang, sitemap, Open Graph).
SITE_URL=https://fanilo.example.com

# Contact form: free access key from https://web3forms.com (sent to your e-mail).
# Leave empty: the form opens the visitor's mail client instead.
PUBLIC_WEB3FORMS_KEY=

# Optional cookieless analytics (Umami). Leave empty to disable.
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_ID=
