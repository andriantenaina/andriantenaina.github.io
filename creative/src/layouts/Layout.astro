---
import '../styles/global.css';
import { getContent, LANGS, profile, type Lang } from '@fa/shared';
import { themeBootScript } from '@fa/shared/palettes';
import PaletteSwitcher from '../components/PaletteSwitcher.astro';
import { versionHref } from '@fa/shared/versions';
// Preload the poster face (Archivo, width axis) and the mono, Latin subset only.
import displayFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import monoFont from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';

interface Props {
  lang: Lang;
  jsonLd?: object;
}

const { lang, jsonLd } = Astro.props;
const c = getContent(lang);
const site = Astro.site!;
// Canonical + hreflang point to the classic version: same content, it is the one search engines should index.
const canonical = new URL(`/${lang}/`, site).href;
const alt = (l: Lang) => new URL(`/${l}/`, site).href;
const ogImage = new URL(`/og-${lang}.png`, site).href;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const classic = versionHref('classic', lang);
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiId = import.meta.env.PUBLIC_UMAMI_ID;
const nav = (['work', 'about', 'skills', 'journey', 'contact'] as const).map((id) => ({ id, label: c.nav[id] }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{c.meta.title}</title>
    <meta name="description" content={c.meta.description} />
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f8fc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b1120" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={alt('fr')} />
    <link rel="alternate" hreflang="en" href={alt('en')} />
    <link rel="alternate" hreflang="x-default" href={alt('en')} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={c.meta.title} />
    <meta property="og:description" content={c.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={c.meta.ogAlt} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline set:html={themeBootScript} />
    {umamiSrc && umamiId && <script defer src={umamiSrc} data-website-id={umamiId} />}
  </head>
  <body class="min-h-svh overflow-x-clip">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-sm focus:bg-fg focus:px-4 focus:py-3 focus:text-bg">{c.ui.skip}</a>

    <header class="site-header fixed inset-x-0 top-0 z-40 border-b border-line bg-bg pt-[env(safe-area-inset-top)]">
      <div class="wrap flex h-[var(--header-h)] items-center gap-6">
        <a href={`${base}${lang}/`} class="condensed mr-auto text-step-0 whitespace-nowrap uppercase">
          Fanilo<span class="sr-only xl:not-sr-only"> Andriantenaina</span>
        </a>
        <nav aria-label={c.ui.menu} class="hidden lg:block">
          <ul class="meta flex gap-5">
            {nav.map((n) => <li><a href={`#${n.id}`} class="inline-flex min-h-11 items-center transition-colors hover:text-fg">{n.label}</a></li>)}
          </ul>
        </nav>
        <div class="flex items-center">
          <ul class="meta hidden sm:flex" aria-label="Language">
            {
              LANGS.map((l) => (
                <li>
                  <a href={`${base}${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} class="inline-flex size-11 items-center justify-center uppercase hover:text-fg aria-[current=true]:text-fg">
                    {l}
                  </a>
                </li>
              ))
            }
          </ul>
          <PaletteSwitcher label={c.ui.palette} id="palette-menu" />
          <button type="button" data-theme-toggle aria-pressed="false" aria-label={c.ui.theme} class="inline-flex size-11 items-center justify-center text-muted hover:text-fg">
            <svg class="size-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
            </svg>
            <svg class="hidden size-[18px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
          </button>
          <a
            href={classic}
            data-version-switch="classic"
            class="ml-1 hidden min-h-10 items-center gap-2 rounded-sm border border-line px-3 text-step--1 font-semibold transition-colors hover:border-accent sm:inline-flex"
          >
            <svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <rect x="3.5" y="4.5" width="17" height="15" rx="2"></rect><path d="M3.5 9h17M9 9v10.5"></path>
            </svg>
            <span class="xl:hidden" aria-hidden="true">{lang === 'fr' ? 'Classique' : 'Classic'}</span>
            <span class="sr-only xl:not-sr-only">{c.ui.classicVersion}</span>
          </a>
          <button type="button" data-menu-button aria-expanded="false" aria-controls="mobile-menu" class="meta -mr-2 inline-flex min-h-11 items-center px-2 text-fg lg:hidden">
            {c.ui.menu}
          </button>
        </div>
      </div>
      <nav id="mobile-menu" hidden aria-label={c.ui.menu} class="border-t border-line lg:hidden">
        <ul class="wrap py-2">
          {
            nav.map((n) => (
              <li class="border-b border-line last:border-0">
                <a href={`#${n.id}`} class="condensed flex min-h-12 items-center text-step-2 uppercase">
                  {n.label}
                </a>
              </li>
            ))
          }
          <li class="flex gap-2 pt-2 sm:hidden">
            {
              LANGS.map((l) => (
                <a href={`${base}${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined} class="meta inline-flex min-h-11 items-center rounded-sm border border-line px-4 uppercase aria-[current=true]:border-accent aria-[current=true]:text-fg">
                  {l}
                </a>
              ))
            }
          </li>
          <li class="pt-3 pb-1">
            <a href={classic} data-version-switch="classic" class="flex min-h-12 items-center justify-between gap-4 rounded-sm border border-line p-4">
              <span class="condensed text-step-1 uppercase">{c.ui.classicVersion}</span>
              <span class="text-accent" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <script>
      import Lenis from 'lenis';
      import { initThemeControls } from '@fa/shared/palettes';

      // Smooth scroll only with a mouse/trackpad and no reduced-motion preference.
      if (matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        new Lenis({ autoRaf: true, anchors: { offset: -80 }, lerp: 0.12 });
      }

      initThemeControls();

      const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
      const menu = document.getElementById('mobile-menu');
      const setMenu = (open: boolean, returnFocus = false) => {
        if (!menuButton || !menu) return;
        menuButton.setAttribute('aria-expanded', String(open));
        menu.hidden = !open;
        if (!open && returnFocus) menuButton.focus();
      };
      menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
      menu?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setMenu(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') setMenu(false, true);
      });
      matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && setMenu(false));

      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
        b.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(b.dataset.copy!);
            const label = b.textContent;
            b.textContent = b.dataset.copied ?? label;
            setTimeout(() => (b.textContent = label), 1800);
          } catch {}
        }),
      );
    </script>
  </body>
</html>
