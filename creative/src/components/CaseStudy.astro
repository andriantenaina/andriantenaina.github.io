---
import type { CaseStudy, Content } from '@fa/shared';

interface Props {
  cs: CaseStudy;
  index: number;
  total: number;
  labels: Content['labels'];
}
const { cs, index, total, labels } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<article class="border-t border-line py-10 first:border-t-0 first:pt-0">
  <p class="meta num">{pad(index + 1)}/{pad(total)} · {cs.kicker}</p>
  <h3 class="condensed mt-3 text-step-2 leading-tight">{cs.title}</h3>
  <p class="mt-4 max-w-[60ch] text-muted">{cs.summary}</p>

  <ul class="mt-6 grid gap-x-6 border-t border-line sm:grid-cols-3">
    {cs.highlights.map((h) => <li class="border-b border-line py-3 text-step--1 font-medium sm:border-b-0">{h}</li>)}
  </ul>

  <div class="mt-8 grid gap-8 md:grid-cols-2">
    <div class="space-y-6">
      <div>
        <h4 class="meta">{labels.problem}</h4>
        <p class="mt-2 text-muted">{cs.problem}</p>
      </div>
      <div>
        <h4 class="meta">{labels.role}</h4>
        <p class="mt-2 text-muted">{cs.role}</p>
      </div>
    </div>
    <div class="space-y-6">
      <div>
        <h4 class="meta">{labels.approach}</h4>
        <ol class="mt-2 space-y-2">
          {
            cs.approach.map((a, i) => (
              <li class="grid grid-cols-[2rem_1fr] text-muted">
                <span class="meta num">{pad(i + 1)}</span>
                {a}
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <h4 class="meta">{labels.results}</h4>
        <ul class="mt-2 space-y-2">{cs.results.map((r) => <li class="border-l-2 border-accent pl-3">{r}</li>)}</ul>
      </div>
    </div>
  </div>
  <p class="meta mt-8">{cs.stack.join(' · ')}</p>
</article>
