---
import { getContent, profile, type Lang } from '@fa/shared';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}
const c = getContent(Astro.props.lang);
const k = c.contact;
const cvs = [
  { label: k.cvFr, href: profile.cv.fr, lang: 'fr' },
  { label: k.cvEn, href: profile.cv.en, lang: 'en' },
];
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="card relative overflow-hidden p-6 sm:p-10 lg:p-14">
      <div class="halo pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <SectionHead id="contact" index="05" title={k.title} intro={k.intro} />

          <div data-reveal class="mt-8 rounded-[var(--radius-btn)] border border-line bg-bg p-4 sm:p-5">
            <p class="meta">E-mail</p>
            <div class="mt-1 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
              <a href={`mailto:${profile.email}`} class="link font-display text-[clamp(1.05rem,0.8rem+1.3vw,1.6rem)] font-semibold break-all">{profile.email}</a>
              <button type="button" data-copy={profile.email} data-copied={k.copied} class="btn-ghost no-print min-h-10 px-3 py-1.5 text-step--1">{k.copy}</button>
            </div>
          </div>

          <div data-reveal="0.05" class="mt-4 grid gap-3 sm:grid-cols-2">
            {
              cvs.map((cv) => (
                <div class="rounded-[var(--radius-btn)] border border-line bg-bg p-4">
                  <p class="meta">
                    {k.cvTitle} · {cv.label}
                  </p>
                  <p class="mt-1 flex gap-4">
                    <a href={cv.href} target="_blank" rel="noopener" hreflang={cv.lang} class="link inline-flex min-h-11 items-center">
                      {k.view}
                    </a>
                    <a href={cv.href} download hreflang={cv.lang} class="link inline-flex min-h-11 items-center">
                      {k.download}
                    </a>
                  </p>
                </div>
              ))
            }
          </div>
          <a data-reveal="0.1" href={profile.linkedin} target="_blank" rel="noopener" data-raw class="link mt-5 inline-flex min-h-11 items-center gap-2">
            linkedin.com/in/fanilo-andriantenaina ↗
          </a>
        </div>

        <form data-contact data-sending={k.sending} data-success={k.success} data-error={k.error} class="grid content-start gap-5 lg:col-span-6" aria-labelledby="form-title">
          <h3 id="form-title" class="font-display text-step-2 font-semibold tracking-tight">{k.formTitle}</h3>
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="grid gap-1.5 text-step--1 font-medium">
              {k.name}
              <input name="name" required autocomplete="name" class="field font-normal" />
            </label>
            <label class="grid gap-1.5 text-step--1 font-medium">
              {k.email}
              <input name="email" type="email" required autocomplete="email" inputmode="email" class="field font-normal" />
            </label>
          </div>
          <label class="grid gap-1.5 text-step--1 font-medium">
            {k.company}
            <input name="company" autocomplete="organization" class="field font-normal" />
          </label>
          <label class="grid gap-1.5 text-step--1 font-medium">
            {k.message}
            <textarea name="message" required rows="6" class="field resize-y font-normal"></textarea>
          </label>
          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" class="btn disabled:opacity-60">
              {k.send}
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
            </button>
            <p data-status role="status" aria-live="polite" class="text-step--1 data-[state=error]:text-[#e5484d] data-[state=ok]:text-accent"></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { initContactForm } from '@fa/shared/contact';
  import { profile } from '@fa/shared';
  initContactForm(import.meta.env.PUBLIC_WEB3FORMS_KEY, profile.email);
</script>
