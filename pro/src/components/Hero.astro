---
import { getContent, profile, type Lang } from '@fa/shared';
import Diagram from './Diagram.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getContent(lang);
const h = c.hero;
const platform = c.caseStudies[0];
const stats = h.heroStats.map((i) => {
  const s = c.stats[i];
  const m = s.value.match(/^(\D*)(\d+)(.*)$/);
  return { ...s, count: m ? Number(m[2]) : undefined, affix: m ? `${m[1]}|${m[3]}` : undefined };
});
// Without JS the last ending is shown, which reads as the plain headline.
const last = h.rotating.length - 1;
---

<section class="relative isolate overflow-hidden">
  <canvas data-flow class="absolute inset-0 -z-10 size-full" aria-hidden="true"></canvas>
  <div class="halo absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-b from-transparent to-bg" aria-hidden="true"></div>

  <div class="wrap pt-[clamp(2.5rem,7vw,6rem)] pb-[clamp(3rem,6vw,5rem)]">
    <div class="flex items-center gap-3.5">
      {
        profile.photo ? (
          <img src={profile.photo} alt="" width="56" height="56" class="size-14 rounded-full object-cover ring-2 ring-accent ring-offset-2 ring-offset-bg" />
        ) : (
          <span class="grid size-14 place-items-center rounded-full bg-surface font-display text-lg font-semibold ring-2 ring-accent ring-offset-2 ring-offset-bg" aria-hidden="true">
            FA
          </span>
        )
      }
      <div class="leading-tight">
        <p class="font-semibold">{profile.name}</p>
        <p class="meta mt-1">{h.role} · <span data-clock>--:--</span> UTC+3</p>
      </div>
    </div>

    <h1 class="mt-8 max-w-[21ch] font-display text-step-5 leading-[1.02] font-semibold tracking-[-0.035em]">
      <span class="sr-only">{h.headline}</span>
      <span aria-hidden="true">
        {h.headlinePrefix}
        <span data-rotator class="grid text-accent">
          {
            h.rotating.map((w, i) => (
              <span class:list={['col-start-1 row-start-1 transition-none', i !== last && 'invisible']} data-word>
                {w}
              </span>
            ))
          }
        </span>
      </span>
    </h1>

    <p class="mt-7 max-w-[60ch] text-step-1 leading-normal text-muted">{h.intro}</p>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href={`mailto:${profile.email}`} class="btn">
        {h.ctaEmail}
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
      </a>
      <a href={profile.cv[lang]} target="_blank" rel="noopener" class="btn-ghost">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6Zm0 0v6h6M8 13h8M8 17h5"></path></svg>
        {c.contact.cvTitle} (PDF)
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener" class="btn-ghost" aria-label="LinkedIn">
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"></path></svg>
        LinkedIn
      </a>
    </div>

    <p class="mt-6 flex items-start gap-2.5 text-step--1 text-muted">
      <span class="mt-[0.45em] size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
      {h.available}
    </p>

    <dl data-reveal="0.1" class="mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="bg-surface p-5 sm:p-6">
            <dt class="num font-display text-step-3 leading-none font-semibold tracking-tight text-accent">
              {s.count !== undefined ? (
                <span data-count={s.count} data-affix={s.affix}>
                  {s.value}
                </span>
              ) : (
                s.value
              )}
            </dt>
            <dd class="mt-3 text-step--1 leading-snug text-muted">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<section class="wrap pb-[clamp(3rem,7vw,6rem)]" aria-labelledby="fig1-title">
  <div data-reveal class="card p-5 sm:p-8">
    <div class="mb-6 flex flex-wrap items-baseline justify-between gap-3">
      <h2 id="fig1-title" class="font-display text-step-2 font-semibold tracking-tight">{platform.title}</h2>
      <p class="eyebrow">{c.labels.architecture}</p>
    </div>
    <Diagram diagram={platform.diagram} alt={platform.diagramAlt} hint={h.diagramHint} />
  </div>
</section>

<script>
  import { animate } from 'motion';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Rotating headline ending ----
  const words = [...document.querySelectorAll<HTMLElement>('[data-rotator] [data-word]')];
  if (words.length > 1 && !reduced) {
    let i = words.length - 1;
    setInterval(() => {
      if (document.hidden) return;
      const prev = words[i];
      i = (i + 1) % words.length;
      const next = words[i];
      animate(prev, { opacity: [1, 0], transform: ['translateY(0)', 'translateY(-0.35em)'] }, { duration: 0.35 }).then(() =>
        prev.classList.add('invisible'),
      );
      next.style.opacity = '0';
      next.classList.remove('invisible');
      animate(next, { opacity: [0, 1], transform: ['translateY(0.35em)', 'translateY(0)'] }, { duration: 0.45, delay: 0.15, ease: [0.22, 1, 0.36, 1] });
    }, 2800);
  }

  // ---- Data-flow background: packets travelling along lanes between nodes ----
  const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-flow]');
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    let w = 0;
    let h = 0;
    let accent = '#4d86ff';
    let line = 'rgba(148,163,184,.16)';
    type Lane = { y: number; amp: number; phase: number; nodes: number[] };
    type Packet = { lane: number; x: number; speed: number; size: number };
    let lanes: Lane[] = [];
    let packets: Packet[] = [];

    const readColors = () => {
      const s = getComputedStyle(document.documentElement);
      accent = s.getPropertyValue('--accent').trim() || accent;
      line = s.getPropertyValue('--line').trim() || line;
    };
    const laneY = (l: Lane, x: number) => l.y + Math.sin(x / 260 + l.phase) * l.amp;

    const setup = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = w < 640 ? 4 : 7;
      lanes = Array.from({ length: count }, (_, k) => ({
        y: h * (0.12 + (0.76 * k) / (count - 1)),
        amp: 14 + Math.random() * 22,
        phase: Math.random() * Math.PI * 2,
        nodes: Array.from({ length: 3 }, () => w * (0.15 + Math.random() * 0.8)),
      }));
      packets = Array.from({ length: w < 640 ? 14 : 34 }, () => ({
        lane: Math.floor(Math.random() * count),
        x: Math.random() * w,
        speed: 0.5 + Math.random() * 1.3,
        size: 1.5 + Math.random() * 1.5,
      }));
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      ctx.lineWidth = 1;
      ctx.strokeStyle = line;
      for (const l of lanes) {
        ctx.beginPath();
        for (let x = 0; x <= w; x += 16) x === 0 ? ctx.moveTo(x, laneY(l, x)) : ctx.lineTo(x, laneY(l, x));
        ctx.stroke();
        ctx.fillStyle = line;
        for (const nx of l.nodes) {
          ctx.beginPath();
          ctx.arc(nx, laneY(l, nx), 3.5, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.fillStyle = accent;
      for (const p of packets) {
        const l = lanes[p.lane];
        const y = laneY(l, p.x);
        ctx.globalAlpha = 0.85;
        ctx.beginPath();
        ctx.arc(p.x, y, p.size, 0, Math.PI * 2);
        ctx.fill();
        // short trail
        ctx.globalAlpha = 0.25;
        ctx.fillRect(p.x - 26, y - 0.5, 22, 1);
      }
      ctx.globalAlpha = 1;
    };

    let raf = 0;
    let visible = true;
    const loop = () => {
      for (const p of packets) {
        p.x += p.speed;
        if (p.x > w + 30) {
          p.x = -30;
          p.lane = Math.floor(Math.random() * lanes.length);
        }
      }
      draw();
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      cancelAnimationFrame(raf);
      if (reduced || !visible || document.hidden) return draw();
      raf = requestAnimationFrame(loop);
    };

    readColors();
    setup();
    start();
    new ResizeObserver(() => {
      setup();
      start();
    }).observe(canvas);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      start();
    }).observe(canvas);
    document.addEventListener('visibilitychange', start);
    window.addEventListener('themechange', () => {
      readColors();
      draw();
    });
  }
</script>
