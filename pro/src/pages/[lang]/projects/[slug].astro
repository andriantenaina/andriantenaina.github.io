---
import { LANGS, getContent, type Lang } from '@fa/shared';
import { caseStudyJsonLd } from '@fa/shared/seo';
import Layout from '../../../layouts/Layout.astro';
import Diagram from '../../../components/Diagram.astro';
import Contact from '../../../components/Contact.astro';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => getContent(lang).caseStudies.map((cs) => ({ params: { lang, slug: cs.slug } })));
}

const lang = Astro.params.lang as Lang;
const c = getContent(lang);
const idx = c.caseStudies.findIndex((x) => x.slug === Astro.params.slug);
const cs = c.caseStudies[idx];
const next = c.caseStudies[(idx + 1) % c.caseStudies.length];
const L = c.labels;
const pad = (n: number) => String(n).padStart(2, '0');
const h2 = 'font-display text-step-2 leading-snug font-semibold tracking-tight';
---

<Layout lang={lang} path={`projects/${cs.slug}/`} title={cs.seoTitle} description={cs.seoDescription} jsonLd={caseStudyJsonLd(lang, cs.slug, Astro.site!.href)}>
  <article>
    <header class="relative isolate overflow-hidden">
      <div class="halo absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="wrap pt-[clamp(2rem,5vw,4rem)] pb-[clamp(2.5rem,6vw,4.5rem)]">
        <a href={`/${lang}/#work`} class="meta inline-flex min-h-11 items-center gap-2 hover:text-fg">← {c.work.back}</a>
        <p data-reveal class="eyebrow mt-8">{pad(idx + 1)}/{pad(c.caseStudies.length)} · {cs.kicker}</p>
        <h1 class="mt-5 max-w-[20ch] font-display text-step-5 leading-[1.03] font-semibold tracking-[-0.035em]">{cs.title}</h1>
        <p data-reveal class="mt-6 max-w-[60ch] text-step-1 leading-normal text-muted">{cs.summary}</p>
        <ul data-reveal="0.05" class="mt-10 grid gap-3 sm:grid-cols-3">
          {
            cs.highlights.map((hl) => (
              <li class="card flex items-start gap-3 p-4 font-medium">
                <svg class="mt-[0.3em] size-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
                  <path d="m5 12 5 5 9-10" />
                </svg>
                {hl}
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <div class="wrap">
      <div data-reveal class="card p-5 sm:p-8">
        <p class="eyebrow mb-6">{L.architecture}</p>
        <Diagram diagram={cs.diagram} alt={cs.diagramAlt} hint={c.hero.diagramHint} />
      </div>
    </div>

    <div class="section">
      <div class="wrap grid gap-y-10 lg:grid-cols-12 lg:gap-x-10">
        <aside class="lg:col-span-4">
          <div class="card p-6 lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
            <p class="eyebrow">{L.stack}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">{cs.stack.map((s) => <span class="chip">{s}</span>)}</div>
            <p class="eyebrow mt-8">{L.role}</p>
            <p class="mt-3 text-step--1 text-muted">{cs.role}</p>
          </div>
        </aside>

        <div class="max-w-[68ch] space-y-14 lg:col-span-8">
          <section data-reveal>
            <h2 class={h2}>{L.problem}</h2>
            <p class="mt-4 text-muted">{cs.problem}</p>
          </section>
          <section data-reveal>
            <h2 class={h2}>{L.approach}</h2>
            <ol class="mt-5 space-y-4">
              {
                cs.approach.map((a, i) => (
                  <li class="flex gap-4">
                    <span class="num grid size-8 shrink-0 place-items-center rounded-lg bg-accent/12 font-mono text-step--1 text-accent">{pad(i + 1)}</span>
                    <span class="pt-0.5 text-muted">{a}</span>
                  </li>
                ))
              }
            </ol>
          </section>
          <section data-reveal>
            <h2 class={h2}>{L.results}</h2>
            <ul class="mt-5 grid gap-3">
              {
                cs.results.map((r) => (
                  <li class="card flex gap-3 border-l-2 border-l-accent p-4">
                    <span>{r}</span>
                  </li>
                ))
              }
            </ul>
          </section>

          <a href={`/${lang}/projects/${next.slug}/`} class="card card-hover group no-print block p-6">
            <span class="eyebrow">{L.nextCase}</span>
            <span class="mt-3 flex items-center justify-between gap-4 font-display text-step-2 leading-snug font-semibold tracking-tight">
              {next.title}
              <svg class="size-5 shrink-0 text-accent transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </article>
  <Contact lang={lang} />
</Layout>
